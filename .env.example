# Copy to .env (never commit .env):  cp .env.example .env

# --- Self-check -----------------------------------------------------------
# Your trainee ID, given by your trainer. Stamped on self_check_report.json.
SELF_CHECK_KEY=trainee-your-name

# --- LLM (milestone 1) -----------------------------------------------------
# anthropic -> uv add langchain-anthropic   |   openai -> uv add langchain-openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith observability (milestone 2) ---------------------------------
# Create a key at https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot-your-name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Chunking (milestone 3) ------------------------------------------------
# Name of a strategy you registered in app/vectordb/chunking.py
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings (milestone 4) ----------------------------------------------
EMBEDDING_MODEL=

# --- Retrieval (milestone 7) -----------------------------------------------
TOP_K=4
# Minimum similarity (0-1) for a retrieved chunk to be used in the answer and shown as a source.
# Leave empty for the calibrated default: 0.60 with BAAI/bge-small-en-v1.5 (the default model),
# no filtering with any other EMBEDDING_MODEL. 0 disables filtering.
RETRIEVAL_MIN_SCORE=

# --- Uploads ----------------------------------------------------------------
# Largest file the upload form accepts (.md, .txt, .pdf), in MB.
MAX_UPLOAD_MB=5

# --- CSV datasets (per chat session) ----------------------------------------
# Largest CSV a chat accepts, in MB (row/column limits: 100,000 rows, 200 columns).
MAX_DATASET_MB=10

# --- Web and image search (see docs/web-and-image-search.md) ----------------
# Google Search grounding through Gemini (not implemented yet; keep false). true / false
WEB_SEARCH_ENABLED=false
# Image cards from Openverse (anonymous, no key needed): none | openverse
IMAGE_SEARCH_PROVIDER=none

# --- MCP (see README.md, "MCP") ----------------------------------------------
# Serve calculator and current_datetime from the local MCP server (stdio subprocess). true / false
MCP_ENABLED=false

# --- Data folders (optional; defaults are under ./data) ---------------------
# DATA_DIR=./data
# SESSIONS_DIR=./data/sessions
# DOCUMENTS_DIR=./data/documents
# VECTOR_DIR=./data/vectorstore
# DATASETS_DIR=./data/datasets
